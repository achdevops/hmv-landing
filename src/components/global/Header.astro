---
import { route, type Locale, type RouteKey } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props {
  locale: Locale;
  current?: RouteKey | undefined;
  alternate: string;
}
const { locale, current, alternate } = Astro.props;
const t = ui[locale];
const items: { key: RouteKey; label: string }[] = [
  { key: 'projects', label: t.projects },
  { key: 'capabilities', label: t.capabilities },
  { key: 'lab', label: t.lab },
  { key: 'learn', label: t.learn },
  { key: 'collaborate', label: t.collaborate },
  { key: 'about', label: t.about },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={route('home', locale)} aria-label={`holaMundoVerde — ${t.home}`}>
      <img src="/images/brand/hmv-isotype.png" alt="" width="256" height="242" />
      <span class="brand-copy">
        <span class="brand-name">holaMundo<strong>Verde</strong></span>
        <span class="brand-descriptor">GreenTech Innovation Lab</span>
      </span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav"
      ><span>{t.menu}</span><i aria-hidden="true"></i></button
    >
    <nav id="main-nav" aria-label={locale === 'es' ? 'Principal' : 'Primary'}>
      <div class="nav-links">
        {
          items.map((item) => (
            <a
              href={route(item.key, locale)}
              aria-current={current === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <LanguageSwitcher {locale} {alternate} />
      <a
        class="contact-link"
        href={route('contact', locale)}
        aria-current={current === 'contact' ? 'page' : undefined}>{t.contact}</a
      >
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  const setOpen = (open: boolean) => {
    if (!button || !nav) return;
    button.setAttribute('aria-expanded', String(open));
    nav.dataset.open = String(open);
    document.body.classList.toggle('nav-open', open);
  };
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
</script>
<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: rgb(245 247 242 / 94%);
    border-bottom: 1px solid rgb(20 33 29 / 12%);
    backdrop-filter: blur(12px);
  }
  .header-inner {
    width: min(calc(100% - 2.5rem), var(--container));
    min-height: 5rem;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink-900);
    text-decoration: none;
  }
  .brand-copy {
    display: grid;
    gap: 0.25rem;
  }
  .brand-name {
    color: var(--ink-900);
    font: 750 1rem/1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .brand strong {
    color: var(--forest-700);
  }
  .brand-descriptor {
    color: var(--slate-600);
    font: 650 0.58rem/1 var(--font-mono);
    letter-spacing: 0.035em;
  }
  .brand img {
    width: 2.7rem;
    height: auto;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.4vw, 1.35rem);
  }
  nav a {
    color: var(--ink-900);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }
  nav a:hover,
  .nav-links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--lime-300);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.4rem;
  }
  .contact-link {
    display: grid;
    min-height: 2.75rem;
    place-items: center;
    padding: 0.5rem 1rem !important;
    color: var(--white) !important;
    background: var(--forest-700);
    border-radius: var(--radius-sm);
  }
  .menu-button {
    display: none;
    min-height: 2.75rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--forest-700);
    border-radius: 0.5rem;
    color: var(--forest-900);
    background: transparent;
    font-weight: 750;
  }
  @media (max-width: 67rem) {
    .menu-button {
      display: block;
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      display: none;
      padding: 1.25rem;
      background: var(--cloud-050);
      border-bottom: 1px solid rgb(20 33 29 / 15%);
      box-shadow: var(--shadow);
    }
    nav[data-open='true'] {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .nav-links {
      display: grid;
      gap: 0;
    }
    .nav-links a {
      display: flex;
      min-height: 3rem;
      align-items: center;
      font-size: 1rem;
    }
    .contact-link {
      grid-column: 1/-1;
    }
    .nav-open {
      overflow: hidden;
    }
  }
  @media (max-width: 25rem) {
    .brand-descriptor {
      display: none;
    }
    nav[data-open='true'] {
      grid-template-columns: 1fr;
    }
    .language {
      margin-top: 0.5rem;
    }
  }
</style>

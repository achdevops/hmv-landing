---
import { route, type Locale } from '@/i18n/routes';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer>
  <div class="container footer-grid">
    <div>
      <div class="footer-lockup">
        <img src="/images/brand/hmv-isotype.png" alt="" width="256" height="242" /><p
          class="footer-brand"
        >
          holaMundoVerde
        </p>
      </div><p>
        {locale === 'es' ? 'Ubicación: Maldonado, Uruguay' : 'Location: Maldonado, Uruguay'}
      </p>
    </div>
    <p>
      {
        locale === 'es'
          ? 'Exploramos ideas, construimos prototipos y aprendemos en colaboración.'
          : 'We explore ideas, build prototypes and learn through collaboration.'
      }
    </p>
    <nav aria-label={locale === 'es' ? 'Pie de página' : 'Footer'}>
      <a href={route('privacy', locale)}>{locale === 'es' ? 'Privacidad' : 'Privacy'}</a>
      <a href={route('contact', locale)}>{locale === 'es' ? 'Contacto' : 'Contact'}</a>
      <a
        href={route('home', locale === 'es' ? 'en' : 'es')}
        hreflang={locale === 'es' ? 'en' : 'es'}>{locale === 'es' ? 'English' : 'Español'}</a
      >
    </nav>
  </div>
</footer>
<style>
  footer {
    padding-block: 4rem;
    color: var(--white);
    background: var(--forest-900);
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }
  .footer-brand {
    font: 700 1.2rem var(--font-display);
  }
  .footer-lockup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .footer-lockup img {
    width: 3rem;
    height: auto;
  }
  footer p {
    color: rgb(255 255 255 / 78%);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  a {
    color: var(--lime-300);
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr auto;
      align-items: start;
    }
  }
</style>

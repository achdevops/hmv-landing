---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { route, type Locale, type RouteKey } from '@/i18n/routes';
type Kind = 'capabilities' | 'lab' | 'learn' | 'collaborate' | 'about' | 'privacy';
const { locale, kind } = Astro.props as { locale: Locale; kind: Kind };
const content = {
  capabilities: {
    es: {
      title: 'Capacidades para investigar, medir y formar',
      lead: 'Conectamos infraestructura digital, datos, observación de campo y aprendizaje para que la sostenibilidad forme parte de cada decisión tecnológica.',
      items: [
        [
          'Infraestructura digital sostenible',
          'Exploramos arquitecturas Cloud, procesamiento, almacenamiento y observabilidad para prototipos. Elegimos servicios según valor, costo, seguridad, eficiencia y huella operativa; no por tendencia.',
        ],
        [
          'IA & datos para sostenibilidad',
          'Investigamos visión computacional, clasificación, análisis geoespacial y flujos asistidos. Calidad de datos, revisión humana, utilidad y costo computacional forman parte de la misma hipótesis.',
        ],
        [
          'Investigación aplicada',
          'Conectamos IoT, sensores, telemetría y fuentes de campo con preguntas verificables. Antes de desplegar, evaluamos conectividad, energía, mantenimiento, privacidad y permisos.',
        ],
        [
          'Formación y cultura GreenTech',
          'Diseñamos talleres para que equipos no especialistas comprendan la huella física de lo digital, formulen mejores preguntas y adopten criterios de medición y mejora continua.',
        ],
      ],
    },
    en: {
      title: 'Capabilities to research, measure and learn',
      lead: 'We connect digital infrastructure, data, field observation and learning so sustainability becomes part of every technology decision.',
      items: [
        [
          'Sustainable digital infrastructure',
          'We explore Cloud architectures, processing, storage and observability for prototypes. We choose services based on value, cost, security, efficiency and operational footprint—not trends.',
        ],
        [
          'AI & data for sustainability',
          'We research computer vision, classification, geospatial analysis and assisted workflows. Data quality, human review, usefulness and compute cost belong to the same hypothesis.',
        ],
        [
          'Applied research',
          'We connect IoT, sensors, telemetry and field sources to verifiable questions. Before deployment, we assess connectivity, energy, maintenance, privacy and permissions.',
        ],
        [
          'GreenTech learning and culture',
          'We design workshops that help non-specialist teams understand the physical footprint of digital systems, ask better questions and adopt measurement and continuous-improvement criteria.',
        ],
      ],
    },
  },
  lab: {
    es: {
      title: 'Un laboratorio para aprender construyendo',
      lead: 'No empezamos por una herramienta. Empezamos por una pregunta, las personas afectadas y la evidencia necesaria para tomar una mejor decisión.',
      items: [
        ['Observar', 'Comprender un problema real y a las personas involucradas.'],
        ['Definir', 'Plantear una hipótesis, restricciones y evidencia necesaria.'],
        ['Investigar', 'Revisar datos, contexto, privacidad y actores.'],
        ['Construir', 'Crear una prueba técnica pequeña y revisable.'],
        ['Probar', 'Buscar un partner, contexto y criterios acordados.'],
        ['Aprender', 'Medir, documentar y decidir si iterar, convertir o cerrar.'],
      ],
    },
    en: {
      title: 'A lab for learning by building',
      lead: 'We do not start with a tool. We start with a question, the people affected and the evidence needed to make a better decision.',
      items: [
        ['Observe', 'Understand a real problem and the people involved.'],
        ['Define', 'State a hypothesis, constraints and required evidence.'],
        ['Research', 'Review data, context, privacy and stakeholders.'],
        ['Build', 'Create a small, reviewable technical proof.'],
        ['Test', 'Seek a partner, context and agreed criteria.'],
        ['Learn', 'Measure, document and decide whether to iterate, convert or close.'],
      ],
    },
  },
  learn: {
    es: {
      title: 'Formación para una cultura tecnológica sostenible',
      lead: 'Diseñamos talleres introductorios y conversaciones para que organizaciones, comunidades educativas y equipos incorporen GreenTech como una capacidad transversal.',
      items: [
        [
          'GreenTech Labs',
          'Cómo pasar de una inquietud ambiental a una pregunta de investigación, una hipótesis y un experimento responsable.',
        ],
        [
          'Huella física de lo digital',
          'Centros de datos, redes, energía, hardware y las decisiones que conectan arquitectura con impacto.',
        ],
        [
          'IA, Cloud e IoT responsables',
          'Fundamentos para evaluar utilidad, datos, cómputo, mantenimiento, privacidad y costo antes de desplegar.',
        ],
        [
          'Tokenización de energía renovable',
          'Trazabilidad, incentivos, límites y decisiones de arquitectura. Contenido cultural; no constituye asesoramiento financiero, legal ni de inversión.',
        ],
      ],
    },
    en: {
      title: 'Learning for a sustainable technology culture',
      lead: 'We design introductory workshops and discussions that help organizations, learning communities and teams develop GreenTech as a cross-functional capability.',
      items: [
        [
          'GreenTech Labs',
          'How to move from an environmental concern to a research question, hypothesis and responsible experiment.',
        ],
        [
          'The physical footprint of digital systems',
          'Data centers, networks, energy, hardware and the decisions connecting architecture to impact.',
        ],
        [
          'Responsible AI, Cloud and IoT',
          'Foundations for assessing usefulness, data, compute, maintenance, privacy and cost before deployment.',
        ],
        [
          'Renewable-energy tokenization',
          'Traceability, incentives, limitations and architecture choices. Cultural content; not financial, legal or investment advice.',
        ],
      ],
    },
  },
  collaborate: {
    es: {
      title: 'Construyamos la próxima prueba juntos',
      lead: 'Buscamos relaciones concretas, con expectativas claras y una pregunta que podamos validar.',
      items: [
        ['Sitio piloto', 'Propón un contexto y una decisión real por mejorar.'],
        ['Datos e investigación', 'Aporta una fuente autorizada, metodología o validación.'],
        [
          'Cloud, IoT o hardware',
          'Contribuye infraestructura, créditos, sensores, drones o equipamiento.',
        ],
        ['Programa o financiación', 'Ayuda a llevar una hipótesis hacia una prueba medible.'],
        ['Talleres y mentoría', 'Facilita un espacio o comparte experiencia técnica.'],
      ],
    },
    en: {
      title: 'Let us build the next test together',
      lead: 'We seek concrete relationships, clear expectations and a question we can validate.',
      items: [
        ['Pilot site', 'Propose a context and a real decision to improve.'],
        ['Data and research', 'Contribute an authorized source, methodology or validation.'],
        [
          'Cloud, IoT or hardware',
          'Contribute infrastructure, credits, sensors, drones or equipment.',
        ],
        ['Program or funding', 'Help move a hypothesis toward a measurable test.'],
        ['Workshops and mentorship', 'Host a space or share technical experience.'],
      ],
    },
  },
  about: {
    es: {
      title: 'holaMundoVerde: código, territorio y aprendizaje',
      lead: 'Somos una iniciativa familiar de Maldonado con vocación de laboratorio. Unimos experiencia tecnológica, curiosidad y sostenibilidad para investigar, formar capacidades y construir colaboraciones paso a paso.',
      items: [
        ['Construcción gradual', 'Una investigación, un prototipo y una colaboración a la vez.'],
        [
          'Identidad institucional',
          'Protegemos la privacidad familiar y mantenemos un punto de contacto común.',
        ],
        [
          'Principios',
          'Evidencia antes que promesas, etapas visibles, datos responsables y aprendizaje documentado.',
        ],
      ],
    },
    en: {
      title: 'holaMundoVerde: code, territory and learning',
      lead: 'We are a family-led initiative from Maldonado with a lab mindset. We bring together technology experience, curiosity and sustainability to research, build capabilities and develop collaborations step by step.',
      items: [
        ['Gradual growth', 'One research question, prototype and collaboration at a time.'],
        [
          'Institutional identity',
          'We protect family privacy and maintain one shared point of contact.',
        ],
        [
          'Principles',
          'Evidence before promises, visible stages, responsible data and documented learning.',
        ],
      ],
    },
  },
  privacy: {
    es: {
      title: 'Privacidad',
      lead: 'Borrador para revisión legal antes de habilitar el formulario en producción.',
      items: [
        [
          'Datos que solicitamos',
          'Nombre, email, organización opcional, interés, etapa opcional, mensaje, consentimiento, idioma y página de origen. No envíes datos sensibles ni información confidencial.',
        ],
        [
          'Finalidad',
          'Usar los datos únicamente para responder la consulta y continuar una conversación solicitada.',
        ],
        [
          'Proveedores',
          'La implementación prevista utiliza Cloudflare para protección y procesamiento del formulario, y Mailgun para entrega del correo. Región y transferencias están pendientes de confirmación.',
        ],
        [
          'Conservación y derechos',
          'El plazo de conservación, responsable de tratamiento y procedimiento de acceso, corrección o eliminación deben confirmarse antes de producción. Escribe a hola@holamundoverde.com para consultas.',
        ],
      ],
    },
    en: {
      title: 'Privacy',
      lead: 'Draft pending legal review before the production contact form is enabled.',
      items: [
        [
          'Data we request',
          'Name, email, optional organization, interest, optional stage, message, consent, language and source page. Do not send sensitive data or confidential information.',
        ],
        [
          'Purpose',
          'Use the data only to answer the inquiry and continue a requested conversation.',
        ],
        [
          'Providers',
          'The planned implementation uses Cloudflare to protect and process the form, and Mailgun to deliver email. Region and transfers remain to be confirmed.',
        ],
        [
          'Retention and rights',
          'Retention, the data controller and the access, correction or deletion process must be confirmed before production. Email hola@holamundoverde.com with questions.',
        ],
      ],
    },
  },
} as const;
const c = content[kind][locale];
const routeKey = kind as RouteKey;
const title = `${c.title} | holaMundoVerde`;
const description = c.lead;
const alternate = route(kind as RouteKey, locale === 'es' ? 'en' : 'es');
const capabilityIcons = [
  '/images/icons/green-solutions.png',
  '/images/icons/ai-for-green.png',
  '/images/icons/innovation-lab.png',
  '/images/icons/education.png',
];
const heroVisual =
  kind === 'capabilities'
    ? {
        src: '/images/generated/digital-infrastructure-footprint.webp',
        alt:
          locale === 'es'
            ? 'Visual conceptual de infraestructura digital conectada con fuentes de energía renovable.'
            : 'Conceptual visual of digital infrastructure connected to renewable energy sources.',
      }
    : kind === 'learn'
      ? {
          src: '/images/generated/learning-workshops.webp',
          alt:
            locale === 'es'
              ? 'Grupo pequeño explorando un sensor ambiental y un módulo solar en un taller.'
              : 'Small group exploring an environmental sensor and a solar module in a workshop.',
        }
      : kind === 'about'
        ? {
            src: '/images/generated/about-maldonado-lab.webp',
            alt:
              locale === 'es'
                ? 'Personas trabajando con sensores y un mapa costero en una mesa de laboratorio.'
                : 'People working with sensors and a coastal map at a laboratory table.',
          }
        : undefined;
---

<BaseLayout {locale} {title} {description} {routeKey} {alternate}>
  <header class="page-hero">
    <div class:list={['container', 'page-hero-grid', { 'page-hero-grid--visual': heroVisual }]}>
      <div>
        <p class="eyebrow">
          holaMundoVerde · {kind === 'privacy' ? (locale === 'es' ? 'Aviso' : 'Notice') : kind}
        </p>
        <h1>{c.title}</h1>
        <p class="lead">{c.lead}</p>
      </div>
      {
        heroVisual && (
          <figure>
            <img src={heroVisual.src} alt={heroVisual.alt} width="1600" height="900" />
            <figcaption>{locale === 'es' ? 'Imagen conceptual' : 'Conceptual image'}</figcaption>
          </figure>
        )
      }
    </div>
  </header>
  <section class="section">
    <div class:list={['container', 'items', { 'items--method': kind === 'lab' }]}>
      {
        c.items.map(([heading, body], i) => (
          <article>
            <>
              <span>0{i + 1}</span>
              {kind === 'capabilities' && (
                <img src={capabilityIcons[i]} alt="" width="256" height="256" />
              )}
              <h2>{heading}</h2>
              <p>{body}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  {
    kind === 'capabilities' && (
      <aside class="evidence-strip">
        <div class="container grid-2">
          <h2>
            {locale === 'es'
              ? 'De la intención a una práctica medible'
              : 'From intention to measurable practice'}
          </h2>
          <div>
            <p>
              {locale === 'es'
                ? 'La huella del software combina energía, intensidad de carbono y emisiones incorporadas del hardware. Por eso proponemos investigar antes de prometer y medir antes de compensar.'
                : 'Software footprint combines energy, the carbon intensity of electricity and embodied hardware emissions. That is why we propose researching before making promises and measuring before offsetting.'}
            </p>
            <div class="source-links">
              <a
                href="https://greensoftware.foundation/standards/sci/"
                target="_blank"
                rel="noreferrer"
              >
                {locale === 'es'
                  ? 'Estándar SCI · Green Software Foundation'
                  : 'SCI standard · Green Software Foundation'}{' '}
                ↗
              </a>
              <a href="https://www.iea.org/reports/energy-and-ai" target="_blank" rel="noreferrer">
                Energy and AI · IEA ↗
              </a>
            </div>
          </div>
        </div>
      </aside>
    )
  }
  {
    kind !== 'privacy' && (
      <section class="cta">
        <div class="container grid-2">
          <>
            <h2>
              {locale === 'es'
                ? '¿Qué podríamos explorar juntos?'
                : 'What could we explore together?'}
            </h2>
            <div>
              <>
                <p>
                  {locale === 'es'
                    ? 'Comparte un desafío, un recurso o una pregunta concreta.'
                    : 'Share a challenge, a resource or a concrete question.'}
                </p>
                <Button
                  href={`${route('contact', locale)}${kind === 'learn' ? '?interest=workshop' : ''}`}
                  variant="light"
                >
                  {locale === 'es' ? 'Iniciar una conversación' : 'Start a conversation'}
                </Button>
              </>
            </div>
          </>
        </div>
      </section>
    )
  }
</BaseLayout>
<style>
  .page-hero {
    padding-block: clamp(4rem, 10vw, 8rem);
    background: linear-gradient(130deg, var(--white), var(--sand-200));
  }
  .page-hero-grid {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .page-hero h1 {
    max-width: 16ch;
  }
  .page-hero figure {
    overflow: hidden;
    margin: 0;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .page-hero figure img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .page-hero figcaption {
    padding: 0.7rem 1rem;
    color: var(--slate-600);
    font: 650 0.7rem var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .items {
    display: grid;
    gap: 0;
    border-top: 1px solid rgb(20 33 29 / 18%);
  }
  .items article {
    display: grid;
    gap: 1rem;
    padding: 2rem 0;
    border-bottom: 1px solid rgb(20 33 29 / 18%);
  }
  .items span {
    font: 700 0.75rem var(--font-mono);
    color: var(--forest-700);
  }
  .items h2 {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
  }
  .items img {
    width: 4rem;
    height: 4rem;
  }
  .items p {
    color: var(--slate-600);
  }
  .cta {
    padding-block: clamp(4rem, 8vw, 7rem);
    color: var(--white);
    background: var(--forest-900);
  }
  .cta p {
    margin-bottom: 1.5rem;
    color: rgb(255 255 255 / 75%);
  }
  .evidence-strip {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    color: var(--white);
    background: var(--forest-800);
  }
  .evidence-strip p {
    color: rgb(255 255 255 / 76%);
  }
  .source-links {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .source-links a {
    color: var(--lime-300);
    font-weight: 750;
  }
  @media (min-width: 50rem) {
    .page-hero-grid--visual {
      grid-template-columns: 1fr 0.9fr;
    }
    .items article {
      grid-template-columns: 0.35fr 1fr 1.5fr;
      align-items: start;
    }
    .items article:has(img) {
      grid-template-columns: 0.2fr 0.35fr 0.8fr 1.5fr;
    }
    .items--method {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 2rem;
    }
    .items--method article {
      display: block;
    }
    .items--method article h2 {
      margin: 0.8rem 0;
    }
  }
</style>
